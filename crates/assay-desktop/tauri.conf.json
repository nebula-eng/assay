{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assay",
  "version": "0.1.3",
  "identifier": "dev.assay.workbench",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Assay — Static Supply-Chain Analysis",
        "width": 1480,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Static supply-chain analysis workbench",
    "longDescription": "Assay dissects PE, ELF and Mach-O artefacts together with archives and scripts, reporting structure, inferred ATT&CK capability, indicators of compromise and a decomposed risk score — entirely offline, without executing the sample.",
    "copyright": "Assay Contributors. Licensed under MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
