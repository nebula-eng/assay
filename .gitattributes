# Normalise line endings so a Windows checkout and a Linux checkout produce
# identical bytes for source and documentation.
* text=auto eol=lf

*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary

# Fixtures are generated, not hand-edited.
samples/* -text

# Cargo lockfile is committed: this is an application, not a library, so a
# reproducible dependency graph matters more than downstream flexibility.
Cargo.lock text eol=lf
