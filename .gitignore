# Generated fixtures — reproducible with `make samples`
samples/*
!samples/.gitkeep

# Tauri writes the capability manifests and JSON schemas on every build; they are
# derived from tauri.conf.json and the plugin set, never edited by hand.
crates/assay-desktop/gen/

# Screenshots and traces from `scripts/ui_shots.mjs` / `design_audit.mjs`.
.shots/

# Private working notes kept by the local assistant. Not part of the project.
.workbuddy/

# Reports and scratch output
*.report.json
*.report.html
bom.json
out/
scratch/
*.pcap
*.pcapng

